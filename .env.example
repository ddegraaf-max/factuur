APP_NAME=EasyInvoice
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_VERSION="Easy 1.2.0"
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Amsterdam
APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- DATABASE ----
# Default: SQLite (zero-config). For production use MySQL or PostgreSQL.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=easyinvoice
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL (common on Railway/Render/Fly):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=easyinvoice
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---- MAIL ----
# Production: Resend (smtp.resend.com). API key = wachtwoord.
# Maak account op resend.com, genereer API key, plak hier (of in Railway Variables).
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Voor lokale ontwikkeling (geen echte mails versturen):
# MAIL_MAILER=log

# De proefherinnering wordt vooruit ingepland via de Resend-API (geen cron nodig).
# Hiervoor wordt MAIL_PASSWORD (de Resend API key) gebruikt; optioneel apart:
# RESEND_KEY=

# ---- STRIPE (abonnement €10/maand) ----
# 1) Maak een Product + recurring Price (€10 / maand) in het Stripe dashboard.
# 2) STRIPE_PRICE_ID = de price-id (price_...).
# 3) STRIPE_SECRET   = je geheime sleutel (sk_live_... of sk_test_...).
# 4) Stel een webhook in op {APP_URL}/stripe/webhook en plak het signing secret
#    (whsec_...) in STRIPE_WEBHOOK_SECRET. Events: checkout.session.completed,
#    customer.subscription.updated, customer.subscription.deleted, invoice.paid.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

VITE_APP_NAME="${APP_NAME}"

# ---------- Cloudflare Turnstile (bot-bescherming) ----------
# Maak een widget aan op https://dash.cloudflare.com > Turnstile.
# Sitekey is publiek; secret is geheim. VITE_TURNSTILE_SITEKEY moet gelijk zijn
# aan TURNSTILE_SITEKEY (de VITE_-versie wordt in de Vue-frontend gebruikt).
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
VITE_TURNSTILE_SITEKEY=

# ---------- Sessie-hardening (productie) ----------
# Zet op true zodra de site via HTTPS draait (easyinvoice.nl).
SESSION_SECURE_COOKIE=true

# KvK API (developers.kvk.nl) — zonder key blijft de KvK-zoeker verborgen.
# Testomgeving: KVK_API_BASE=https://api.kvk.nl/test met de publieke testkey.
KVK_API_KEY=
# KVK_API_BASE=https://api.kvk.nl

# Peppol via Recommand (recommand.eu): teamkey van EasyInvoice + webhook-geheim.
RECOMMAND_API_KEY=
RECOMMAND_API_SECRET=
RECOMMAND_WEBHOOK_SECRET=

# Bankkoppeling via Ponto (Ibanity) — PEM's letterlijk of base64
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
PONTO_CERTIFICATE=
PONTO_PRIVATE_KEY=
PONTO_KEY_PASSPHRASE=
PONTO_SIGNATURE_CERTIFICATE_ID=
PONTO_SIGNATURE_PRIVATE_KEY=
PONTO_SIGNATURE_KEY_PASSPHRASE=
PONTO_SANDBOX=false
PONTO_ACCOUNT_PRICE=5
# Stripe-price (maandelijks, per stuk) voor de bankkoppeling per rekening
STRIPE_PRICE_ID_BANK=
